<Page
    x:Class="ModernTinyWall.Views.OverviewPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ModernTinyWall.Models">

    <Page.Resources>
        <SolidColorBrush x:Key="NetworkDownloadBrush" Color="#FF0078D4" />
        <SolidColorBrush x:Key="NetworkUploadBrush" Color="#FF107C10" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Border CornerRadius="12" Padding="24,18" MinHeight="140">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF153C68" Offset="0" />
                        <GradientStop Color="#FF087FA5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="TINYWall  /  FIREWALL CONTROL"
                                   FontSize="12" FontWeight="SemiBold" CharacterSpacing="120"
                                   Foreground="#FFD2F2FF" />
                        <TextBlock Text="Your network, your rules."
                                   FontSize="28" FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="See what's happening and choose how your PC connects."
                                   FontSize="15" Foreground="#FFE2F4FA"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Column="1" Width="112" Height="112"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="112" Height="112" Fill="#2286D9F2" />
                        <Ellipse Width="84" Height="84" Fill="#3386D9F2"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Border Width="64" Height="64" CornerRadius="18"
                                Background="#26FFFFFF"
                                BorderBrush="#66FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA18;" FontSize="32" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Network activity" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Live traffic across active network adapters"
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20"
                                VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="DOWNLOAD" Style="{StaticResource EyebrowStyle}"
                                       Foreground="#FF0078D4" />
                            <TextBlock Text="{x:Bind ViewModel.DownloadRate, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="UPLOAD" Style="{StaticResource EyebrowStyle}"
                                       Foreground="#FF107C10" />
                            <TextBlock Text="{x:Bind ViewModel.UploadRate, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="8" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="126" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBlock x:Name="BandwidthScaleTopText" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="BandwidthScaleMiddleText" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="0 B/s" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" />
                            <Canvas x:Name="NetworkActivityCanvas"
                                    SizeChanged="NetworkActivityCanvas_SizeChanged" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="-5 min" HorizontalAlignment="Left" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="-2.5 min" HorizontalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Now" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="Protection mode" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Choose how TinyWall handles network traffic."
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="16" Height="16"
                                  IsActive="{x:Bind ViewModel.IsApplyingMode, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3"
                                           MinItemWidth="220" MinItemHeight="108"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:FirewallModeOption">
                            <Button Padding="14" Margin="0,0,10,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Command="{Binding ViewModel.ApplyModeCommand, ElementName=PageRoot}"
                                    CommandParameter="{x:Bind}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xEA18;" FontSize="18"
                                                  Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
