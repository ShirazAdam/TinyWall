<Page
    x:Class="ModernTinyWall.Views.OverviewPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ModernTinyWall.Models">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="#FF389BFF" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="#FF4DDD91" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="#FFFFD700" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="#FFFF686F" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="#FFFF69B4" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="#FFB1BCD0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="#FF006BC2" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="#FF117A42" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="#FF947800" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="#FFC72C3A" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="#FFBC257D" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="#FF616C7F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20" MaxWidth="1440" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Your network, your rules." FontSize="16"
                           Foreground="{ThemeResource ModernMutedBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="14" RowSpacing="14" SizeChanged="SummaryPanels_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernPanelStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" FontSize="26" Foreground="{ThemeResource ModernAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Total download" Foreground="{ThemeResource ModernMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.TotalDownloadRate, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModernPanelStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE898;" FontSize="26" Foreground="{ThemeResource ModernAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Total upload" Foreground="{ThemeResource ModernMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.TotalUploadRate, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ModernPanelStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{ThemeResource ModernAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Traffic history" Foreground="{ThemeResource ModernMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="5 minutes" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource ModernPanelStyle}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Network activity" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NetworkActivityStatus, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="8" SizeChanged="SeriesSelectors_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <CheckBox x:Name="InternetDownloadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Internet download"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource NetworkDownloadBrush}" />
                                    <TextBlock Text="Internet download" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.DownloadRate, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2">
                            <CheckBox x:Name="InternetUploadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Internet upload"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource NetworkUploadBrush}" />
                                    <TextBlock Text="Internet upload" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.UploadRate, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <CheckBox x:Name="LocalDownloadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Local download"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource LocalDownloadBrush}" />
                                    <TextBlock Text="Local download" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.LocalDownloadRate, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                            <CheckBox x:Name="LocalUploadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Local upload"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource LocalUploadBrush}" />
                                    <TextBlock Text="Local upload" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.LocalUploadRate, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <CheckBox x:Name="TotalDownloadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Total download"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource TotalDownloadBrush}" />
                                    <TextBlock Text="Total download" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.TotalDownloadRate, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="1" Spacing="2">
                            <CheckBox x:Name="TotalUploadCheckBox" IsChecked="True"
                                      AutomationProperties.Name="Total upload"
                                      Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource TotalUploadBrush}" />
                                    <TextBlock Text="Total upload" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ViewModel.TotalUploadRate, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SeriesSettingsStatus" Grid.Row="3" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <Border Grid.Row="1" Padding="0,8">
                    <Grid RowSpacing="8" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBlock x:Name="BandwidthScaleTopText" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="BandwidthScaleMiddleText" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="0 B/s" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" />
                            <Canvas x:Name="NetworkActivityCanvas" Grid.RowSpan="2"
                                    SizeChanged="NetworkActivityCanvas_SizeChanged" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="-5 min" HorizontalAlignment="Left" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="-2.5 min" HorizontalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Now" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            </Border>

            <Border Style="{StaticResource ModernPanelStyle}">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="Protection mode" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Choose how Modern TinyWall handles network traffic."
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="16" Height="16"
                                  IsActive="{x:Bind ViewModel.IsApplyingMode, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="5"
                                           MinItemWidth="140" MinItemHeight="200"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:FirewallModeOption">
                            <Button Padding="14" Margin="0,0,10,10"
                                    AutomationProperties.Name="{x:Bind DisplayName}"
                                    ToolTipService.ToolTip="{x:Bind Description}"
                                    PointerEntered="ModeTile_PointerEntered"
                                    PointerExited="ModeTile_PointerExited"
                                    PointerCanceled="ModeTile_PointerExited"
                                    CornerRadius="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{ThemeResource ModernSurfaceBrush}"
                                    BorderBrush="{x:Bind ModeBrush}"
                                    BorderThickness="1"
                                    Command="{Binding ViewModel.ApplyModeCommand, ElementName=PageRoot}"
                                    CommandParameter="{x:Bind}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <StackPanel Spacing="12" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Border Width="44" Height="44" CornerRadius="14"
                                            Background="{x:Bind ModeBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="24"
                                                  Foreground="{x:Bind IconBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
