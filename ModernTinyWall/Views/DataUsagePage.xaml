<Page
    x:Class="ModernTinyWall.Views.DataUsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ModernTinyWall.ViewModels"
    xmlns:controls="using:ModernTinyWall.Controls">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Data usage" Style="{StaticResource PageTitleStyle}" />
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search applications or executable paths"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search applications" />
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="PeriodPicker" Header="Period" SelectedIndex="0"
                      SelectionChanged="PeriodPicker_SelectionChanged" MinWidth="150">
                <ComboBoxItem Content="Today" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="Last 30 days" />
                <ComboBoxItem Content="All time" />
            </ComboBox>
            <ComboBox Header="Sort by" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="180">
                <ComboBoxItem Content="Total (highest first)" />
                <ComboBoxItem Content="Application path" />
                <ComboBoxItem Content="Internet incoming" />
                <ComboBoxItem Content="Internet outgoing" />
                <ComboBoxItem Content="Local incoming" />
                <ComboBoxItem Content="Local outgoing" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                              AutomationProperties.Name="Loading data usage" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="{ThemeResource ModernBorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Background="{ThemeResource ModernSurfaceBrush}">
        <ListView ItemsSource="{x:Bind ViewModel.Applications}"
                  SelectionMode="None" HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Application data usage"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Grid MinWidth="1000" Padding="8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Application" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Total" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Internet incoming" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Internet outgoing" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Local incoming" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Local outgoing" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DataUsageRow">
                    <Grid MinWidth="1000" Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind ApplicationPath}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:ApplicationIcon SourcePath="{x:Bind ApplicationPath}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Application}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ApplicationPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Total}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind InternetReceived}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind InternetSent}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind LocalReceived}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind LocalSent}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Border>
        <TextBlock Grid.Row="5" TextWrapping="Wrap"
                   Text="TCP/UDP traffic recorded by the TinyWall service. Private, loopback, link-local, shared-address and multicast/broadcast destinations count as Local, including private-address VPN traffic. Periods include today and use local calendar days. History starts when tracking is enabled; it does not include earlier usage." />
    </Grid>
</Page>
