<Page
    x:Class="ModernTinyWall.Views.OverviewPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ModernTinyWall.Models">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="#389BFF" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="#4DDD91" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="#FFDA53" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="#FF5368" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="#F15BBD" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="#9AAEC9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="#006BC2" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="#117A42" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="#947800" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="#C72C3A" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="#BC257D" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="#616C7F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NetworkDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NetworkUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LocalDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LocalUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TotalDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TotalUploadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="LegendRateStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource ModernMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer SizeChanged="Dashboard_SizeChanged" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,18,24,20" Spacing="14" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your network, your rules." FontSize="15" Foreground="{ThemeResource ModernMutedBrush}" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{ThemeResource ModernBorderBrush}"
                        Background="{ThemeResource ModernSelectionBrush}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ProtectionDetail, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.ProtectionBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ProtectionStatus, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14" RowSpacing="10" SizeChanged="SummaryPanels_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource DashboardSummaryButtonStyle}" Click="ProtectionSummary_Click"
                        AutomationProperties.Name="Show protection modes">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA18;" FontSize="32" Foreground="{ThemeResource ModernAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Protection mode" FontSize="12" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentModeName, Mode=OneWay}" FontSize="19"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProtectionDetail, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource DashboardSummaryButtonStyle}" Click="ConnectionsSummary_Click"
                        AutomationProperties.Name="Review active connections">
                    <Grid ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionsDetail, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE968;" FontSize="32" Foreground="{ThemeResource ModernAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Active connections" FontSize="12" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveConnections, Mode=OneWay}" FontSize="19" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource DashboardSummaryButtonStyle}" Click="ConnectionsSummary_Click"
                        AutomationProperties.Name="Review connection activity">
                    <Grid ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind ViewModel.BlockedDetail, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE730;" FontSize="32" Foreground="{ThemeResource LocalUploadBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Blocked today" FontSize="12" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BlockedToday, Mode=OneWay}" FontSize="19" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                    </Grid>
                </Button>
            </Grid>

            <Border Style="{StaticResource ModernPanelStyle}" Padding="16,12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Network activity" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TrafficSourceLabel, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource ModernMutedBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5" Background="Transparent"
                                BorderThickness="0" AutomationProperties.Name="Traffic tracking status">
                            <Button.Content>
                                <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource ModernMutedBrush}" />
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock Text="{x:Bind ViewModel.NetworkActivityStatus, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="Wrap" />
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.NetworkActivityStatus, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" RowSpacing="5" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PlotHeight" Height="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBlock x:Name="BandwidthScaleTopText" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock x:Name="BandwidthScaleUpperText" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,0,0" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock x:Name="BandwidthScaleMiddleText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock x:Name="BandwidthScaleLowerText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,32" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="0 B/s" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="4" BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="1,1,1,1" Opacity="0.5" />
                            <Border Grid.Row="0" BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.3" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.3" />
                            <Border Grid.Row="2" BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.3" />
                            <Canvas x:Name="NetworkActivityCanvas" Grid.RowSpan="4" SizeChanged="NetworkActivityCanvas_SizeChanged" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="-5 min" HorizontalAlignment="Left" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="-2.5 min" HorizontalAlignment="Center" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                            <TextBlock Text="Now" HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource ModernMutedBrush}" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="1"
                            Background="{ThemeResource ModernInsetBrush}" CornerRadius="6" Padding="8,2">
                        <Grid ColumnSpacing="14" RowSpacing="0" SizeChanged="SeriesSelectors_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="InternetDownloadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Internet download" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource NetworkDownloadBrush}" />
                                        <TextBlock Text="Internet download" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DownloadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                            <Grid Grid.Column="1" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="InternetUploadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Internet upload" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource NetworkUploadBrush}" />
                                        <TextBlock Text="Internet upload" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UploadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                            <Grid Grid.Column="2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="LocalDownloadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Local download" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource LocalDownloadBrush}" />
                                        <TextBlock Text="Local download" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LocalDownloadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="LocalUploadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Local upload" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource LocalUploadBrush}" />
                                        <TextBlock Text="Local upload" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LocalUploadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="TotalDownloadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Total download" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource TotalDownloadBrush}" />
                                        <TextBlock Text="Total download" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalDownloadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="TotalUploadCheckBox" IsChecked="True" MinWidth="0" MinHeight="32"
                                          AutomationProperties.Name="Total upload" Checked="SeriesSelection_Changed" Unchecked="SeriesSelection_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource TotalUploadBrush}" />
                                        <TextBlock Text="Total upload" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalUploadRate, Mode=OneWay}" Style="{StaticResource LegendRateStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SeriesSettingsStatus" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Grid>
            </Border>

            <Border x:Name="ProtectionPanel" Style="{StaticResource ModernPanelStyle}" Padding="16,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Protection mode" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="5"
                                               MinItemWidth="126" MinItemHeight="128" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:FirewallModeOption">
                                <Button Padding="0" Margin="0,0,8,0" CornerRadius="6"
                                        AutomationProperties.Name="{x:Bind DisplayName}"
                                        ToolTipService.ToolTip="{x:Bind Description}"
                                        PointerEntered="ModeTile_PointerEntered" PointerExited="ModeTile_PointerExited"
                                        PointerCanceled="ModeTile_PointerExited"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Background="{ThemeResource ModernInsetBrush}"
                                        BorderBrush="{ThemeResource ModernBorderBrush}" BorderThickness="1"
                                        Command="{Binding ViewModel.ApplyModeCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Border BorderBrush="{ThemeResource ModernAccentBrush}" BorderThickness="2" CornerRadius="5"
                                                Background="{ThemeResource ModernSelectionBrush}"
                                                Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                                        <StackPanel Padding="10,12" Spacing="8" HorizontalAlignment="Stretch">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="28" Foreground="{x:Bind ModeBrush}" />
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13" TextAlignment="Center" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource ModernMutedBrush}" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                               Visibility="{x:Bind ViewModel.ModeStatusVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource ModernMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
