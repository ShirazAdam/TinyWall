<Page
    x:Class="ModernTinyWall.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="32" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Modern TinyWall brings TinyWall's firewall controls to a modern Windows interface."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <HyperlinkButton Content="github.com/ShirazAdam/TinyWall"
                         NavigateUri="https://github.com/ShirazAdam/TinyWall"
                         HorizontalAlignment="Left" />
    </StackPanel>
</Page>
