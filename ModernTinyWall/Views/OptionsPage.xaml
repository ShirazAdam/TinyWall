<Page
    x:Class="ModernTinyWall.Views.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="20">
        <StackPanel Spacing="6">
            <TextBlock Text="Options" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Choose how Modern TinyWall behaves when using the title-bar buttons."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ToggleSwitch
            x:Name="MinimiseToTraySwitch"
            Header="Minimise to tray"
            OffContent="Minimise to taskbar"
            OnContent="Hide the window and keep Modern TinyWall running in the tray"
            Toggled="OptionsSwitch_Toggled" />

        <ToggleSwitch
            x:Name="CloseToTraySwitch"
            Header="Close to tray"
            OffContent="Close the application"
            OnContent="Hide the window and keep Modern TinyWall running in the tray"
            Toggled="OptionsSwitch_Toggled" />

        <StackPanel Spacing="8">
            <TextBlock Text="Overview cards" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Choose which summary cards appear on the Overview page."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ToggleSwitch x:Name="ProtectionCardSwitch" Header="Protection mode" Toggled="OptionsSwitch_Toggled" />
            <ToggleSwitch x:Name="ConnectionsCardSwitch" Header="Active connections" Toggled="OptionsSwitch_Toggled" />
            <ToggleSwitch x:Name="BlockedTrafficCardSwitch" Header="Blocked today" Toggled="OptionsSwitch_Toggled" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Connection history" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Optional local history can include application names or executable paths, IP addresses and ports. Collection pauses while the window is hidden."
                       TextWrapping="Wrap" Foreground="{ThemeResource ModernMutedBrush}" />
            <ToggleSwitch x:Name="CollectHistorySwitch" Header="Collect connection history"
                          OffContent="Off" OnContent="Stored on this PC" Toggled="OptionsSwitch_Toggled" />
            <ComboBox x:Name="HistoryRetentionBox" Header="Keep history for"
                      SelectionChanged="HistoryRetention_SelectionChanged" MinWidth="200">
                <ComboBoxItem Content="7 days" Tag="7" />
                <ComboBoxItem Content="30 days" Tag="30" />
                <ComboBoxItem Content="90 days" Tag="90" />
            </ComboBox>
            <Button Content="Clear connection history" Click="ClearHistory_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <Button Content="Getting started guide" Click="GettingStarted_Click" HorizontalAlignment="Left" />

        <InfoBar
            IsOpen="True"
            Severity="Informational"
            Title="Tray behaviour"
            Message="The tray icon remains available while Modern TinyWall is hidden. Use the tray menu or the terminate button below to fully exit." />

        <InfoBar x:Name="OptionsStatus" IsOpen="False" Severity="Informational" />

        <Button Content="Terminate application" Click="TerminateButton_Click" HorizontalAlignment="Left" />
    </StackPanel>
</Page>
