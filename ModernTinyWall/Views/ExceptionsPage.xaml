<Page
    x:Class="ModernTinyWall.Views.ExceptionsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ModernTinyWall.ViewModels"
    xmlns:controls="using:ModernTinyWall.Controls">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Exceptions" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Choose which applications and services can use the network."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search application exceptions" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Search" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="TypeFilter" Header="Type" SelectedIndex="0"
                      SelectionChanged="Filters_SelectionChanged" MinWidth="150">
                <ComboBoxItem Content="All types" />
                <ComboBoxItem Content="Executable" />
                <ComboBoxItem Content="Service" />
                <ComboBoxItem Content="Global" />
                <ComboBoxItem Content="UWP app" />
            </ComboBox>
            <ComboBox x:Name="PolicyFilter" Header="Policy" SelectedIndex="0"
                      SelectionChanged="Filters_SelectionChanged" MinWidth="180">
                <ComboBoxItem Content="All policies" />
                <ComboBoxItem Content="Hard block" />
                <ComboBoxItem Content="Unrestricted" />
                <ComboBoxItem Content="TCP/UDP" />
                <ComboBoxItem Content="Rule list" />
            </ComboBox>
            <ComboBox x:Name="AgeFilter" Header="Created" SelectedIndex="0"
                      SelectionChanged="Filters_SelectionChanged" MinWidth="160">
                <ComboBoxItem Content="Any time" />
                <ComboBoxItem Content="Last 24 hours" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="Last 30 days" />
            </ComboBox>
            <TextBox Header="Filter tags" PlaceholderText="Tag" Width="140" TextChanged="TagFilter_TextChanged" />
        </StackPanel>

        <InfoBar Grid.Row="3" IsOpen="True" Severity="Informational"
                 Title="Rule health review"
                 Message="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="5" BorderBrush="{ThemeResource ModernBorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Background="{ThemeResource ModernSurfaceBrush}">
        <controls:TableView x:Name="ExceptionsList" ItemsSource="{x:Bind ViewModel.Exceptions, Mode=OneWay}"
                            SelectionMode="Multiple" SelectionChanged="ExceptionsList_SelectionChanged">
            <controls:TableView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ExceptionRowViewModel">
                    <Grid controls:TableView.IsRow="True" Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:ApplicationIcon SourcePath="{x:Bind IconPath}" PackageFamilyName="{x:Bind PackageFamilyName}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind SubjectType}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Policy}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind PolicyScope}" AutomationProperties.HelpText="{x:Bind PolicyScope}" />
                        <StackPanel Grid.Column="4" Spacing="2">
                            <TextBlock Text="{x:Bind Created}" />
                            <TextBlock Text="{x:Bind Duration}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="{x:Bind ReviewFinding}" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind ReviewFinding}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind Tags}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </controls:TableView.ItemTemplate>
        </controls:TableView>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Add" Command="{x:Bind AddCommand}" />
            <Button Content="Modify" Command="{x:Bind ModifyCommand}" />
            <Button Content="Edit tags" Click="EditTags_Click" />
            <Button Content="Remove selected" Command="{x:Bind RemoveCommand}" />
            <Button Content="Remove all" Command="{x:Bind RemoveAllCommand}" />
        </StackPanel>
    </Grid>
</Page>