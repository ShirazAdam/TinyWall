<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<Version>4.5.8</Version>
	<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
	<LangVersion>14.0</LangVersion>
	<Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
	<RootNamespace>ModernTinyWall.TinyWall</RootNamespace>
	<DefineConstants>$(DefineConstants);TINYWALL_CORE</DefineConstants>
	<Copyright>Copyright 2026 Modern TinyWall</Copyright>
	<NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="NeoSmart.AsyncLock" Version="3.2.1" />
	<PackageReference Include="System.Runtime.WindowsRuntime" Version="4.7.0" />
	<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

	<ItemGroup>
	<Compile Include="..\TinyWall.Shared\**\*.cs" LinkBase="Shared" />
	<InternalsVisibleTo Include="ModernTinyWall.Exceptions.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernTinyWall.Windows\ModernTinyWall.Windows.csproj" />
  </ItemGroup>
</Project>
